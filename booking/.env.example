# =====================================================================
#  Pilanka Booking – zmienne środowiskowe (Railway → Variables)
#  Wymagane w produkcji oznaczono [WYMAGANE].
# =====================================================================

NODE_ENV=production
# PORT ustawia Railway automatycznie.

# --- Baza danych (Railway: dodaj usługę PostgreSQL i użyj referencji ${{Postgres.DATABASE_URL}}) ---
DATABASE_URL=postgresql://user:password@host:5432/railway          # [WYMAGANE]
# DATABASE_SSL=true      # tylko przy połączeniu przez publiczny proxy Railway

# --- Bezpieczeństwo ---
OTP_SECRET=wygeneruj-przez-openssl-rand-hex-32                       # [WYMAGANE] min. 32 znaki
ALLOWED_ORIGINS=https://pilankapilatestczew.pl,https://www.pilankapilatestczew.pl   # [WYMAGANE]
# TRUST_PROXY=1          # liczba proxy przed aplikacją (Railway: 1)

# --- Google Calendar (Service Account) ---
GCAL_PROVIDER=google
GOOGLE_CALENDAR_ID=adres-kalendarza@group.calendar.google.com        # [WYMAGANE]
# Jedna z trzech opcji [WYMAGANE]:
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...","client_email":"...@....iam.gserviceaccount.com"}
# GOOGLE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoi...
# GOOGLE_SERVICE_ACCOUNT_FILE=/sciezka/do/klucza.json
# GCAL_CACHE_SECONDS=30        # cache odczytu Free/Busy dla listy terminów (przy rezerwacji zawsze świeży odczyt)
# GCAL_EVENT_COLOR_ID=2        # kolor wydarzeń rezerwacji w GCal (1–11)
# EVENT_TITLE_PREFIX=Rezerwacja

# --- Bramka SMS: smsapi | twilio ---
SMS_PROVIDER=smsapi                                                  # [WYMAGANE]
# SMSAPI.pl
SMSAPI_TOKEN=token-oauth-z-panelu-smsapi
SMSAPI_SENDER=Pilanka          # zatwierdzona nazwa nadawcy (opcjonalnie)
# SMSAPI_BASE_URL=https://api.smsapi.pl
# SMSAPI_TEST_MODE=false       # true = SMSAPI tylko waliduje, nie wysyła
# Twilio
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM=+48...           # albo:
# TWILIO_MESSAGING_SERVICE_SID=MG...
# Treść SMS ({code}, {minutes}, {business}); bez polskich znaków = 160 znaków w 1 SMS
# SMS_TEMPLATE={code} - Twoj kod do rezerwacji w {business}. Wazny {minutes} min.
# OTP_WEBOTP_DOMAIN=pilankapilatestczew.pl   # autouzupełnianie kodu w Chrome/Android

# --- Grafik i zasady rezerwacji ---
BUSINESS_NAME=Pilanka Pilates Tczew
TIMEZONE=Europe/Warsaw
# Dni: mon tue wed thu fri sat sun (lub pn wt sr cz pt so nd), zakresy "mon-fri", wiele przedziałów po przecinku
WORKING_HOURS=mon-fri=08:00-20:00;sat=09:00-14:00
# CLOSED_DATES=2026-12-24,2026-12-25,2026-12-26
SLOT_DURATION_MIN=60           # długość zajęć
# BUFFER_MIN=0                 # przerwa przed/po zajętym terminie
# SLOT_STEP_MIN=60             # co ile minut zaczynają się sloty (domyślnie długość + bufor)
SLOT_CAPACITY=1                # 1 = zajęcia indywidualne; >1 = liczba miejsc w grupie
MIN_NOTICE_MIN=120             # najpóźniej ile minut przed zajęciami można rezerwować
BOOKING_HORIZON_DAYS=60        # na ile dni do przodu
HOLD_MINUTES=10                # soft lock terminu na czas weryfikacji SMS
# BOOKING_RETENTION_DAYS=90    # RODO: po ilu dniach od zajęć usuwać dane z bazy (GCal zostaje)
# PRIVACY_POLICY_URL=https://pilankapilatestczew.pl/polityka-prywatnosci

# --- Kod OTP i limity (ochrona przed nadużyciami i kosztami SMS) ---
# OTP_TTL_SECONDS=300            # ważność kodu (5 min)
# OTP_MAX_ATTEMPTS=5             # błędnych prób na kod
# SMS_RESEND_COOLDOWN_SECONDS=60 # minimalny odstęp między SMS-ami na ten sam numer
# SMS_LIMIT_PER_PHONE_HOUR=3     # max SMS na numer / godzinę
# SMS_LIMIT_PER_IP_HOUR=5        # max SMS z jednego IP / godzinę
# SMS_LIMIT_GLOBAL_DAY=150       # bezpiecznik budżetu: max SMS dziennie łącznie
# API_RATE_LIMIT_PER_MINUTE=120
# VERIFY_RATE_LIMIT_PER_10MIN=30

# --- Cloudflare Turnstile (opcjonalna, zalecana ochrona antybotowa) ---
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET_KEY=0x4AAAAAAA...

# --- Alerty dla studia (opcjonalnie, zalecane) ---
# Powiadomienie, gdy rezerwacje przestają działać: brak środków/zły token SMS, dzienny limit SMS, awaria Google.
# Najprościej: aplikacja ntfy na telefon + temat, którego nikt nie zgadnie.
# ALERT_WEBHOOK_URL=https://ntfy.sh/pilanka-rezerwacje-7f3k9q   # albo webhook Discord/Slack
# ALERT_COOLDOWN_MINUTES=60      # ten sam alert najwyżej raz na godzinę
# SMS_LOW_BALANCE_ALERT=100      # ostrzeż, gdy saldo bramki SMS spadnie poniżej (pkt SMSAPI / waluta Twilio)

# --- Inne ---
# ENABLE_DEMO=false              # strona /demo (domyślnie wyłączona w produkcji)
# LOG_LEVEL=info
