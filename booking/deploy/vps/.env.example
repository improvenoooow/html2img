# Skopiuj do .env (cp .env.example .env) i uzupełnij. Plik .env nie trafia do gita.
# Pełny opis wszystkich opcji: booking/.env.example

# --- Infrastruktura VPS ---
BOOKING_DOMAIN=rezerwacje.pilankapilatestczew.pl   # wariant A (Caddy)
APP_PORT=8080                                      # wariant B: port na 127.0.0.1 dla nginx/Apache
POSTGRES_PASSWORD=                                 # openssl rand -hex 24  (tylko litery i cyfry)

# --- Bezpieczeństwo ---
OTP_SECRET=                                        # openssl rand -hex 32
ALLOWED_ORIGINS=https://pilankapilatestczew.pl,https://www.pilankapilatestczew.pl

# --- Google Calendar ---
GOOGLE_CALENDAR_ID=
# Klucz Service Account zakodowany w base64 (jedna linia, bez problemów z cudzysłowami):
#   base64 -w0 klucz.json
GOOGLE_SERVICE_ACCOUNT_BASE64=

# --- SMS ---
SMS_PROVIDER=smsapi
SMSAPI_TOKEN=
SMSAPI_SENDER=
# Domena strony z formularzem DOKŁADNIE taka jak w pasku adresu (z www albo bez) – inaczej autouzupełnianie
# kodu na Androidzie po cichu nie zadziała.
OTP_WEBOTP_DOMAIN=pilankapilatestczew.pl

# --- Alerty (zalecane): aplikacja ntfy na telefonie + tajny temat ---
ALERT_WEBHOOK_URL=
SMS_LOW_BALANCE_ALERT=100

# --- Grafik ---
BUSINESS_NAME=Pilanka Pilates Tczew
WORKING_HOURS=mon-fri=08:00-20:00;sat=09:00-14:00
SLOT_DURATION_MIN=60
SLOT_CAPACITY=1
MIN_NOTICE_MIN=120
BOOKING_HORIZON_DAYS=60
PRIVACY_POLICY_URL=https://pilankapilatestczew.pl/polityka-prywatnosci
